  "chinese_text": {
    "1": {
      "lines": [
        "众人都当感谢，将荣耀献上，",
        "世上的人哪，",
        "献给那位，天使天军",
        "在天上不住颂赞的，"
      ],
      "translator": "AI v3.2",
      "translated_at": "2026-08-16T21:42:37.410131"
    },
    "2": {
      "lines": [
        "振作起来，扬声歌唱，",
        "唱给上帝，我们至高的善，",
        "他随处施行奇事，",
        "又行大事。"
      ],
      "translator": "AI v3.2",
      "translated_at": "2026-08-16T21:42:37.410143"
    },
    "3": {
      "lines": [
        "他从母腹起",
        "就使我们健壮康泰，",
        "在人无力相助之处，",
        "他亲自作我们的帮助。"
      ],
      "translator": "AI v3.2",
      "translated_at": "2026-08-16T21:42:37.410146"
    },
    "4": {
      "lines": [
        "我们纵然大大伤他心，",
        "他却仍存善心，",
        "免去刑罚，赦免罪债，",
        "又赐我们一切美善。"
      ],
      "translator": "AI v3.2",
      "translated_at": "2026-08-16T21:42:37.410148"
    },
    "5": {
      "lines": [
        "愿他赐我们喜乐的心，",
        "更新我们的灵与意念，",
        "将一切惧怕、恐惧、忧愁与痛苦",
        "都投入深海。"
      ],
      "translator": "AI v3.2",
      "translated_at": "2026-08-16T21:42:37.410150"
    },
    "6": {
      "lines": [
        "愿他让他的平安安歇",
        "在以色列之地，",
        "愿他赐福我们手中的工作，",
        "赐救恩给各等身份的人。"
      ],
      "translator": "AI v3.2",
      "translated_at": "2026-08-16T21:42:37.410151"
    },
    "7": {
      "lines": [
        "愿他让他的慈爱与良善",
        "环绕、临近并与我们同行，",
        "但使那令人忧虑烦扰之事",
        "远远离开我们。"
      ],
      "translator": "AI v3.2",
      "translated_at": "2026-08-16T21:42:37.410152"
    },
    "8": {
      "lines": [
        "只要此生尚存，",
        "愿他永远作我们的救恩，",
        "当我们离开这地之时，",
        "也作我们的份。"
      ],
      "translator": "AI v3.2",
      "translated_at": "2026-08-16T21:42:37.410154"
    },
    "9": {
      "lines": [
        "当心破碎之时，愿他",
        "合上我们的双眼，",
        "并随即向我们显出他的面",
        "在那永恒的安息里。"
      ],
      "translator": "AI v3.2",
      "translated_at": "2026-08-16T21:42:37.410155"
    }
  }
}
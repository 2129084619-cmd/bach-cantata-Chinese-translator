  "chinese_text": {
    "9": {
      "lines": [
        "对我所行的说声「是」吧，",
        "亲自帮助我筹算最好的事；",
        "我的起头、中间与结局，",
        "主啊，求你转向最好。"
      ],
      "translator": "AI v3.2",
      "translated_at": "2026-08-16T23:23:36.425797"
    },
    "10": {
      "lines": [
        "求你以祝福护佑我，",
        "让我的心作你的居所，",
        "让你的话作我的食粮，",
        "直到我启程升入高天！"
      ],
      "translator": "AI v3.2",
      "translated_at": "2026-08-16T23:23:36.425802"
    }
  }

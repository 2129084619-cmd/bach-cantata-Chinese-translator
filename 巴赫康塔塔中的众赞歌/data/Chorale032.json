  "chinese_text": {
    "6": {
      "lines": [
        "圣灵啊，坐在天上宝座，",
        "从永远就是同等的上帝，",
        "与父与子同等，",
        "是忧伤者的安慰与喜乐！",
        "我里面所存的信心，",
        "都是你在我里面点燃，",
        "求你在恩典中掌管我，",
        "并长久保守你的恩典。"
      ],
      "translator": "AI v3.2",
      "translated_at": "2026-08-16T23:23:36.422119"
    },
    "7": {
      "lines": [
        "求你向我施下帮助，",
        "哦，你这尊贵的内心之客！",
        "求你成就那善工，",
        "就是你所起头的。",
        "求你在我里面吹旺那小火苗，",
        "直到跑完当跑的路，",
        "我得以像蒙拣选的人，",
        "并达到信心的目标。"
      ],
      "translator": "AI v3.2",
      "translated_at": "2026-08-16T23:23:36.422273"
    }
  }
}